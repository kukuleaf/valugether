NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://stock_app:stock_app_dev_password@localhost:5433/stock_screener
REDIS_URL=redis://localhost:6379
BATCH_WORKER_ENABLED=false
BATCH_QUEUE_NAME=right-stock-batch
BATCH_REDIS_STARTUP_TIMEOUT_MS=10000
FINANCIAL_SYNC_CHUNK_SIZE=200

# HTTP security
CORS_ALLOWED_ORIGINS=http://localhost:3100,http://127.0.0.1:3100
TRUST_PROXY_HOPS=0
RATE_LIMIT_ENABLED=true
RATE_LIMIT_STORE=memory
RATE_LIMIT_REDIS_URL=redis://localhost:6379
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
SEARCH_RATE_LIMIT_MAX=30
SEARCH_RATE_LIMIT_WINDOW_SECONDS=60

JWT_ACCESS_SECRET=CHANGE_ME_TO_LONG_RANDOM_VALUE
JWT_ACCESS_MINUTES=15
REFRESH_TOKEN_DAYS=30
IP_HASH_SALT=CHANGE_ME

# Financial data
DART_API_KEY=
SEC_USER_AGENT=StockScreener/0.1 contact@example.com

# Market data adapter
MARKET_DATA_PROVIDER=mock
MARKET_DATA_API_KEY=
MARKET_DATA_BASE_URL=https://api.marketstack.com/v1

# Korea Investment & Securities Open API (server only)
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_BASE_URL=https://openapi.koreainvestment.com:9443
KIS_REQUEST_INTERVAL_MS=100
KIS_TOKEN_CACHE_PATH=.cache/kis-token.json

# Social Login (server-side secrets only)
GOOGLE_WEB_CLIENT_ID=
GOOGLE_WEB_CLIENT_SECRET=
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Email
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_CONNECTION_TIMEOUT_MS=5000
SMTP_GREETING_TIMEOUT_MS=5000
SMTP_SOCKET_TIMEOUT_MS=10000
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@example.local
EMAIL_VERIFICATION_URL=rightstockvalue://auth/verify-email
PASSWORD_RESET_URL=rightstockvalue://auth/reset-password
PRESET_ALERT_URL=rightstockvalue://custom
PRESET_ALERT_EMAIL_ENABLED=false
EMAIL_VERIFICATION_MINUTES=30
PASSWORD_RESET_MINUTES=30
AUTH_TOKEN_REQUEST_COOLDOWN_SECONDS=60

# Data quality and operational alerts
DATA_QUALITY_PRICE_MAX_AGE_DAYS=4
DATA_QUALITY_FINANCIAL_MAX_AGE_DAYS=550
DATA_QUALITY_MIN_PRICE_COVERAGE_PERCENT=80
DATA_QUALITY_MIN_METRIC_COVERAGE_PERCENT=70
DATA_QUALITY_STUCK_BATCH_MINUTES=180
DATA_QUALITY_RECENT_FAILURE_HOURS=24
OPS_ALERT_EMAIL_ENABLED=false
OPS_ALERT_EMAILS=
OPS_ALERT_COOLDOWN_HOURS=24
