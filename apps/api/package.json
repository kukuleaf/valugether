{
  "name": "@stock-screener/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "nest start",
    "start:dev": "nest start --watch",
    "build": "nest build",
    "typecheck": "tsc --noEmit",
    "test:e2e": "npm run build --silent && node --env-file=.env --test --test-concurrency=1 test/api.e2e.mjs",
    "test:batch": "npm run build --silent && node --env-file=.env --test --test-concurrency=1 test/market-price.e2e.mjs",
    "test:queue": "npm run build --silent && node ../../tools/run-queue-e2e.mjs",
    "create-admin": "tsx scripts/create-admin.ts",
    "sync-data": "npm run build --silent && node --env-file=.env dist/scripts/sync-data.js",
    "data-status": "npm run build --silent && node --env-file=.env dist/scripts/data-status.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.3",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.2.3",
    "@nestjs/jwt": "^11.0.1",
    "@nestjs/platform-express": "^11.2.3",
    "argon2": "^0.44.0",
    "bullmq": "^6.3.8",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^17.2.2",
    "exceljs": "^4.4.0",
    "helmet": "^8.1.0",
    "ioredis": "^6.0.0",
    "nodemailer": "^10.0.10",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@types/node": "^24.3.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
