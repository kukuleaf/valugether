# Android emulator -> PC localhost is usually 10.0.2.2
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:3000/api
EXPO_PUBLIC_API_BASE_URL_WEB=http://localhost:3000/api
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
# Kakao Native app key is embedded in the Android app; never put Admin/Client Secret here.
EXPO_PUBLIC_KAKAO_NATIVE_APP_KEY=73768284f3439336e69ae94cda9b976f
# Naver Android SDK build credentials. Never use EXPO_PUBLIC_ for these values.
# Injected into native resources, not JavaScript; APK resources can still be extracted.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
EXPO_PUBLIC_ADS_ENABLED=true
# Development and preview use Google demo IDs automatically. Real IDs are required only for production.
EXPO_PUBLIC_ADMOB_ANDROID_APP_ID=
EXPO_PUBLIC_ADMOB_BANNER_UNIT_ID=
# Optional per-placement units, recommended for separate revenue reporting.
EXPO_PUBLIC_ADMOB_HOME_BANNER_UNIT_ID=
EXPO_PUBLIC_ADMOB_RESULTS_BANNER_UNIT_ID=
